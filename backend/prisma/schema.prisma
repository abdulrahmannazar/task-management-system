generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Department {
  department_id Int        @id @default(autoincrement())
  name          String     @db.VarChar(100)
  
  employees     Employee[]
  services      Service[]
  loe_approvals LoeDepartmentApproval[]

  @@map("departments")
}

model Employee {
  emp_id               Int                     @id @default(autoincrement())
  department_id        Int
  manager_id           Int?
  name                 String                  @db.VarChar(100)
  email                String                  @unique @db.VarChar(150)
  password             String                  @db.VarChar(255) 
  role                 String                  @default("EMPLOYEE") @db.VarChar(20)
  is_active            Boolean                 @default(true)

  // Relations
  department           Department              @relation(fields: [department_id], references: [department_id])
  manager              Employee?               @relation("EmployeeHierarchy", fields: [manager_id], references: [emp_id])
  subordinates         Employee[]              @relation("EmployeeHierarchy")
  loes_created         Loe[]                   @relation("LoeCreator")
  loes_approved        Loe[]                   @relation("LoeApprover")
  department_approvals LoeDepartmentApproval[] @relation("DepartmentReviewer")
  jobs_managed         Job[]                   @relation("JobManager")
  tasks                Task[]                  @relation("TaskAssignees")

  @@map("employees")
}

model Company {
  company_id   Int     @id @default(autoincrement())
  name         String  @db.VarChar(150)
  client_type  String  @db.VarChar(50)
  reg_number   String? @unique @db.VarChar(50)
  tin_number   String? @db.VarChar(50)
  email        String? @db.VarChar(150)
  phone_number String? @db.VarChar(25)

  loes         Loe[]

  @@map("companies")
}

model Service {
  service_id    Int         @id @default(autoincrement())
  department_id Int
  name          String      @db.VarChar(150)
  sub_category  String?     @db.VarChar(100)
  scope         String?     @db.Text
  billing_type  String      @db.VarChar(50)
  price         Decimal     @default(0.00) @db.Decimal(12, 2)
  is_active     Boolean     @default(true)

  // Relations
  department    Department  @relation(fields: [department_id], references: [department_id])
  loe_items     LoeItem[]
  tasks         Task[]

  @@map("services")
}

model Loe {
  loe_id               Int                     @id @default(autoincrement())
  company_id           Int
  created_by           Int
  approved_by          Int?
  status               String                  @db.VarChar(50)
  type                 String                  @db.VarChar(50)
  start_date           DateTime                @db.Date
  end_date             DateTime?               @db.Date

  // Relations
  company              Company                 @relation(fields: [company_id], references: [company_id])
  creator              Employee                @relation("LoeCreator", fields: [created_by], references: [emp_id])
  approver             Employee?               @relation("LoeApprover", fields: [approved_by], references: [emp_id])
  loe_items            LoeItem[]
  department_approvals LoeDepartmentApproval[]
  job                  Job?

  @@map("loes")
}

model LoeItem {
  loe_item_id      Int      @id @default(autoincrement())
  loe_id           Int
  service_id       Int
  custom_scope     String?  @db.Text
  amount           Decimal  @default(0.00) @db.Decimal(12, 2)
  status           String   @default("Pending") @db.VarChar(50)
  rejection_reason String?  @db.Text

  // Relations
  loe              Loe      @relation(fields: [loe_id], references: [loe_id], onDelete: Cascade)
  service          Service  @relation(fields: [service_id], references: [service_id])

  @@map("loe_items")
}

model LoeDepartmentApproval {
  approval_id   Int        @id @default(autoincrement())
  loe_id        Int
  department_id Int
  status        String     @default("Pending") @db.VarChar(50)
  reviewed_by   Int?
  updated_at    DateTime   @default(now()) @updatedAt

  // Relations
  loe           Loe        @relation(fields: [loe_id], references: [loe_id], onDelete: Cascade)
  department    Department @relation(fields: [department_id], references: [department_id], onDelete: Cascade)
  reviewer      Employee?  @relation("DepartmentReviewer", fields: [reviewed_by], references: [emp_id], onDelete: SetNull)

  @@unique([loe_id, department_id])
  @@map("loe_department_approvals")
}

model Job {
  job_id     Int       @id @default(autoincrement())
  loe_id     Int       @unique
  manager_id Int
  status     String    @db.VarChar(50)
  deadline   DateTime? @db.Date

  // Relations
  loe        Loe       @relation(fields: [loe_id], references: [loe_id])
  manager    Employee  @relation("JobManager", fields: [manager_id], references: [emp_id])
  tasks      Task[]
  invoice    Invoice?

  @@map("jobs")
}

model Task {
  task_id          Int        @id @default(autoincrement())
  job_id           Int
  service_id       Int
  status           String     @db.VarChar(50)
  service_deadline DateTime?  @db.Date
  deadline         DateTime?  @db.Date
  duration_days    Int?       
  scope            String?    @db.Text

  // Relations
  job              Job        @relation(fields: [job_id], references: [job_id], onDelete: Cascade)
  service          Service    @relation(fields: [service_id], references: [service_id])
  assignees        Employee[] @relation("TaskAssignees")

  @@map("tasks")
}

model Invoice {
  invoice_id   Int      @id @default(autoincrement())
  job_id       Int      @unique
  total_amount Decimal  @db.Decimal(12, 2)
  status       String   @db.VarChar(50)
  issued_date  DateTime @db.Date
  due_date     DateTime @db.Date

  // Relations
  job          Job      @relation(fields: [job_id], references: [job_id])

  @@map("invoices")
}